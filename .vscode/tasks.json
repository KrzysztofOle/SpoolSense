{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "bash",
            "args": ["-lc", "./tools/run_idf.sh build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash",
            "type": "shell",
            "command": "bash",
            "args": ["-lc", "./tools/run_idf.sh flash"],
            "dependsOn": "Build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Monitor",
            "type": "shell",
            "command": "bash",
            "args": ["-lc", "./tools/run_idf.sh monitor"],
            "problemMatcher": []
        },
        {
            "label": "Flash + Monitor",
            "type": "shell",
            "command": "bash",
            "args": ["-lc", "./tools/run_idf.sh flash monitor"],
            "dependsOn": "Build",
            "problemMatcher": []
        },
        {
            "label": "Full Clean",
            "type": "shell",
            "command": "bash",
            "args": ["-lc", "./tools/run_idf.sh fullclean"],
            "problemMatcher": []
        },
        {
            "label": "Reconfigure",
            "type": "shell",
            "command": "bash",
            "args": ["-lc", "./tools/run_idf.sh reconfigure"],
            "problemMatcher": []
        }
    ]
}
